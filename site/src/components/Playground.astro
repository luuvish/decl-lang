---
// The browser playground: a CodeMirror editor on the left, outputs and
// diagnostics on the right, evaluated by the reference implementation's
// platform-neutral core (`decl-lang/core`, bundled by Vite); the grammar
// wasm files are static assets under public/playground/.
const base = import.meta.env.BASE_URL;
---

<div class="pg-frame not-content">
<div class="pg" data-base={base}>
  <div class="pg-head pg-bar">
    <label class="pg-sample">
      <span>Example</span>
      <select id="pg-sample" aria-label="Load an example"></select>
    </label>
    <button id="pg-run" type="button">Run</button>
    <button id="pg-fmt" type="button">Format</button>
    <button id="pg-share" type="button">Copy link</button>
  </div>
  <div class="pg-head pg-tabbar">
    <div class="pg-tabs" role="tablist" aria-label="Results">
      <button type="button" role="tab" id="pg-tab-output" data-tab="output" class="active" aria-selected="true" aria-controls="pg-output">Output</button>
      <button type="button" role="tab" id="pg-tab-diagnostics" data-tab="diagnostics" aria-selected="false" aria-controls="pg-diags">Diagnostics<span id="pg-count" class="pg-count" hidden></span></button>
    </div>
    <span id="pg-status" class="pg-status" aria-live="polite">loading the runtime…</span>
  </div>
  <div id="pg-editor" class="pg-editor"></div>
  <div class="pg-out">
    <pre id="pg-output" class="pg-pane" role="tabpanel" data-pane="output"></pre>
    <div id="pg-diags" class="pg-pane pg-diags" role="tabpanel" data-pane="diagnostics" hidden></div>
  </div>
</div>
</div>

<script>
  import { EditorView, basicSetup } from 'codemirror';
  import { EditorState } from '@codemirror/state';
  import { keymap } from '@codemirror/view';
  import { indentWithTab } from '@codemirror/commands';
  import { declLanguage, declHighlight } from './decl-mode';
  import { initParser, evaluateSource, format } from 'decl-lang/core';
  import type { Report } from 'decl-lang/core';

  const samples = import.meta.glob('../samples/**/*.decl', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
  const root = document.querySelector<HTMLElement>('.pg')!;
  const base = root.dataset.base ?? '/';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const status = $('pg-status');
  const output = $<HTMLPreElement>('pg-output');
  const diags = $('pg-diags');
  const count = $('pg-count');
  const select = $<HTMLSelectElement>('pg-sample');

  // examples: the landing page's hero first, then the synced validation cases
  const entries = Object.entries(samples).map(([path, src]) => ({ name: path.split('/').pop()!.replace(/\.decl$/, ''), src }));
  entries.sort((a, b) => (a.name === 'hero' ? -1 : b.name === 'hero' ? 1 : a.name.localeCompare(b.name)));
  for (const e of entries) {
    const o = document.createElement('option');
    o.value = e.name;
    o.textContent = e.name === 'hero' ? 'services (landing page)' : e.name;
    select.appendChild(o);
  }

  const fromHash = (): string | null => {
    const m = location.hash.match(/^#code=(.+)$/);
    if (!m) return null;
    try { return decodeURIComponent(escape(atob(decodeURIComponent(m[1])))); } catch { return null; }
  };
  const initial = fromHash() ?? entries[0]?.src ?? '';

  let ready = false;
  let timer: number | undefined;

  const view = new EditorView({
    parent: $('pg-editor'),
    state: EditorState.create({
      doc: initial,
      extensions: [
        basicSetup,
        keymap.of([indentWithTab]),
        declLanguage,
        declHighlight,
        EditorView.theme({
          '&': { height: '100%', fontSize: '0.9rem', backgroundColor: 'var(--sl-color-bg)', color: 'var(--sl-color-text)' },
          '.cm-scroller': { fontFamily: 'var(--__sl-font-mono, ui-monospace, monospace)', lineHeight: '1.5' },
          '.cm-line, .cm-gutterElement': { marginTop: '0' },
          '.cm-gutters': { backgroundColor: 'var(--sl-color-bg-nav)', color: 'var(--sl-color-gray-3)', borderRight: '1px solid var(--sl-color-hairline)' },
          '.cm-activeLine, .cm-activeLineGutter': { backgroundColor: 'var(--decl-field)' },
          '.cm-selectionBackground, &.cm-focused .cm-selectionBackground, .cm-content ::selection': { backgroundColor: 'var(--decl-tint) !important' },
          '.cm-cursor, .cm-dropCursor': { borderLeftColor: 'var(--sl-color-white)' },
          '.cm-selectionMatch': { backgroundColor: 'var(--decl-field)' },
          '&.cm-focused': { outline: 'none' },
        }),
        EditorView.updateListener.of(u => {
          if (!u.docChanged) return;
          window.clearTimeout(timer);
          timer = window.setTimeout(run, 300);
        }),
      ],
    }),
  });

  const source = () => view.state.doc.toString();
  const setSource = (text: string) => view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: text } });

  const pretty = (json: string) => {
    try { return JSON.stringify(JSON.parse(json), null, 2); } catch { return json; }
  };
  const esc = (s: string) => s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));

  function render(rep: Report, ms: number) {
    const all = [...rep.checks, ...rep.diagnostics];
    const errors = all.filter(d => d.severity === 'error').length + rep.parseErrors.length;
    const total = all.length + rep.parseErrors.length;
    count.textContent = String(total);
    count.hidden = total === 0;
    count.classList.toggle('is-error', errors > 0);
    if (rep.phase === 'parse') {
      output.textContent = rep.parseErrors.map(e => `syntax error at line ${e.row + 1}, column ${e.col + 1}`).join('\n');
      status.textContent = `${rep.parseErrors.length} syntax error(s)`;
    } else if (rep.phase === 'check') {
      output.textContent = 'static checks failed — see Diagnostics';
      status.textContent = `${errors} error(s) in static checks · ${ms} ms`;
    } else if (!rep.ok) {
      output.textContent = 'evaluation reported errors — see Diagnostics';
      status.textContent = `${errors} error(s) · ${ms} ms`;
    } else {
      const parts = rep.outputs.map(o => `// output ${o.name}\n${pretty(o.json)}`);
      if (rep.inputs.length) parts.push(`// input ${rep.inputs.join(', ')}: declared, not bound (the playground evaluates a single module)`);
      output.textContent = parts.length ? parts.join('\n\n') : '(no outputs declared)';
      const warns = all.filter(d => d.severity !== 'error').length;
      status.textContent = `ok · ${rep.outputs.length} output${rep.outputs.length === 1 ? '' : 's'}${warns ? ` · ${warns} warning${warns === 1 ? '' : 's'}` : ''} · ${ms} ms`;
    }
    const rows = [
      ...rep.parseErrors.map(e => `<li class="sev-error"><b>error</b> <code>E2001</code> syntax error at line ${e.row + 1}, column ${e.col + 1}</li>`),
      ...all.map(d => `<li class="sev-${esc(d.severity)}"><b>${esc(d.severity)}</b> ${d.code ? `<code>${esc(d.code)}</code>` : ''} ${d.id ? `<i>${esc(d.id)}</i>` : ''}${d.path ? ` <span class="path">at ${esc(d.path)}</span>` : ''}: ${esc(d.message)}</li>`),
    ];
    diags.innerHTML = rows.length ? `<ul>${rows.join('')}</ul>` : '<p class="pg-empty">No diagnostics.</p>';
    // errors bring the diagnostics forward; a clean run brings the output back
    showTab(errors ? 'diagnostics' : 'output');
  }

  function showTab(name: string) {
    for (const b of root.querySelectorAll<HTMLButtonElement>('.pg-tabs [role="tab"]')) {
      const on = b.dataset.tab === name;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
    }
    for (const p of root.querySelectorAll<HTMLElement>('.pg-pane')) p.hidden = p.dataset.pane !== name;
  }
  for (const b of root.querySelectorAll<HTMLButtonElement>('.pg-tabs [role="tab"]')) {
    b.addEventListener('click', () => showTab(b.dataset.tab!));
    b.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        showTab(b.dataset.tab === 'output' ? 'diagnostics' : 'output');
        root.querySelector<HTMLButtonElement>('.pg-tabs [role="tab"].active')?.focus();
      }
    });
  }

  function run() {
    if (!ready) return;
    const t0 = performance.now();
    try {
      const rep = evaluateSource(source());
      render(rep, Math.round(performance.now() - t0));
    } catch (e) {
      output.textContent = `internal error: ${(e as Error).message}`;
      status.textContent = 'internal error';
    }
  }

  select.addEventListener('change', () => {
    const e = entries.find(x => x.name === select.value);
    if (e) { setSource(e.src); history.replaceState(null, '', location.pathname); run(); }
  });
  $('pg-run').addEventListener('click', run);
  $('pg-fmt').addEventListener('click', () => {
    if (!ready) return;
    try { setSource(format(source())); status.textContent = 'formatted'; }
    catch (e) { status.textContent = `format: ${(e as Error).message}`; }
  });
  $('pg-share').addEventListener('click', async () => {
    const code = encodeURIComponent(btoa(unescape(encodeURIComponent(source()))));
    const url = `${location.origin}${location.pathname}#code=${code}`;
    history.replaceState(null, '', `#code=${code}`);
    try { await navigator.clipboard.writeText(url); status.textContent = 'link copied'; }
    catch { status.textContent = 'link is in the address bar'; }
  });

  (async () => {
    try {
      const dir = new URL(`${base.replace(/\/$/, '')}/playground/`, location.origin).href;
      await initParser({ grammar: `${dir}tree-sitter-decl.wasm`, runtime: `${dir}tree-sitter.wasm` });
      ready = true;
      status.textContent = 'ready';
      run();
    } catch (e) {
      status.textContent = `could not load the runtime: ${(e as Error).message}`;
    }
  })();
</script>

<style>
  /* one 2x2 grid: the header row is shared by the toolbar (over the editor)
     and the tab strip (over the results), so the two always line up */
  .pg-frame { margin-top: 1rem; container-type: inline-size; }
  .pg {
    --pg-head: 2.75rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas: "bar tabs" "editor out";
    height: calc(100vh - 17rem);
    min-height: 32rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--decl-radius, 0.125rem);
    overflow: hidden;
    background: var(--sl-color-bg-nav);
  }
  /* stack the panes when the playground itself (not the viewport) gets narrow */
  @container (max-width: 56rem) {
    .pg {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(22rem, auto) auto minmax(16rem, auto);
      grid-template-areas: "bar" "editor" "tabs" "out";
      height: auto;
    }
    .pg-bar, .pg-editor { border-right: 0; }
    .pg-editor { border-bottom: 1px solid var(--sl-color-hairline); }
  }
  .pg-head {
    display: flex;
    align-items: center;
    min-height: var(--pg-head);
    min-width: 0;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-nav);
    font-size: 0.85rem;
  }
  .pg-bar {
    grid-area: bar;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-right: 1px solid var(--sl-color-hairline);
  }
  .pg-sample { display: flex; align-items: center; gap: 0.4rem; }
  .pg-bar select, .pg-bar button {
    font: inherit;
    margin: 0;
    line-height: 1.4;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--decl-radius, 0.125rem);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  .pg-bar select { max-width: 11rem; }
  .pg-bar button:hover { border-color: var(--sl-color-white); color: var(--sl-color-white); }
  .pg-tabbar { grid-area: tabs; align-items: stretch; }
  .pg-status {
    align-self: center;
    margin-left: auto;
    padding: 0 0.75rem;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--sl-color-gray-3);
  }
  .pg-editor { grid-area: editor; min-height: 0; border-right: 1px solid var(--sl-color-hairline); }
  /* the results: one visible pane under the tab strip */
  .pg-out {
    grid-area: out;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }
  .pg-tabs {
    display: flex;
    align-items: stretch;
    flex: none;
    margin: 0;
  }
  .pg-tabs [role="tab"] {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin: 0;
    padding: 0 1rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .pg-tabs [role="tab"]:hover { color: var(--sl-color-text); }
  .pg-tabs [role="tab"].active { color: var(--sl-color-white); border-bottom-color: var(--sl-color-white); }
  .pg-tabs [role="tab"]:focus-visible { outline: 2px solid var(--sl-color-white); outline-offset: -2px; }
  .pg-count {
    display: inline-block;
    min-width: 1.4em;
    padding: 0 0.4em;
    border-radius: 1em;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-text);
    font-size: 0.75em;
    line-height: 1.6;
    text-align: center;
    text-transform: none;
  }
  .pg-count.is-error { background: var(--decl-error); color: var(--sl-color-black); }
  .pg-count[hidden] { display: none; }
  .pg-pane {
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0.75rem;
    overflow: auto;
    font-size: 0.85rem;
    white-space: pre;
    background: var(--sl-color-bg);
  }
  .pg-pane[hidden] { display: none; }
  .pg-diags { white-space: normal; }
  #pg-diags ul { list-style: none; padding: 0; margin: 0; }
  #pg-diags li { padding: 0.35rem 0.5rem; border-left: 3px solid var(--sl-color-gray-4); margin-bottom: 0.35rem; font-family: var(--__sl-font-mono, ui-monospace, monospace); font-size: 0.8rem; }
  #pg-diags li.sev-error { border-left-color: var(--decl-error); }
  #pg-diags li.sev-warn { border-left-color: var(--decl-warning); }
  #pg-diags li.sev-info { border-left-color: var(--decl-info); }
  #pg-diags li b { text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.06em; }
  #pg-diags li.sev-error b { color: var(--decl-error); }
  #pg-diags li.sev-warn b { color: var(--decl-warning); }
  #pg-diags li.sev-info b { color: var(--decl-info); }
  #pg-diags .path { color: var(--sl-color-gray-3); }
  .pg-empty { color: var(--sl-color-gray-3); margin: 0; }
</style>
