// Values, derived meaning, and relationships in one model.
type Service = {
    name: /[a-z][a-z0-9-]*/
    port?: 1024..65535 = 8080
    endpoint = `${name}:${port}`
    inbound_count = std.array.count($referrers(Link, "target"))
}

type Link = {
    source: ref<Service>
    target: ref<Service>

    assert different_services: source != target
        else error `a service must not link to itself`
}

type Topology = { services: Service[], links: Link[] }

export output demo: Topology = {
    services: [{ name: "gateway" }, { name: "auth", port: 9001 }]
    links: [{ source: services[0], target: services[1] }]
}

// External JSON documents use exactly the same model.
input deployed: Topology
