// `null` is an ordinary value: comparing against it is plain equality, and
// `P != null` narrows P in the true branch (§4.5, §4.10)
type Slot = {
    buffer?: int? = null
    configured = buffer != null
    cleared = buffer == null
    size = if buffer != null then buffer else 0
}
type Rack = {
    slots?: Slot[] = []
    any_set = std.array.any(slots, (s) => s.buffer != null)
}
output r: Rack = { slots: [{ }, { buffer: 64 }] }
