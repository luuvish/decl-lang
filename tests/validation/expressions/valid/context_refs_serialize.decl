// $this and $parent are references: a member holding one serializes as a
// canonical path, never as a copy of the containing value (§7.3)
type Child = {
    $parent: ref<{ name: string, ... }>
    label: string
    owner = $parent
    me = $this
    owner_name = $parent.name
}
type Parent = { name: string, kids?: Child[] = [] }
output p: Parent = { name: "p", kids: [{ label: "k" }] }
