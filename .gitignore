# What the tree does not carry (docs/DEVELOPMENT.md §1): build outputs,
# dependencies, environments, the copies a build makes, and local state.

# macOS
.DS_Store

# build outputs and dependencies, in any package
node_modules/
dist/
build/
target/

# Python: bytecode, packaging metadata, the venv `make` creates, tool caches
__pycache__/
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# copies a build makes: the grammar sources synced into the Rust crate and
# the Python extension, the LICENSE carried into each package, packed tarballs
decl-rs/grammar/
decl-rs/LICENSE
decl-py/decl/_tree_sitter/src/
decl-py/decl/_tree_sitter/*.so
decl-py/LICENSE
decl-ts/LICENSE
decl-ts/*.tgz

# the website: generated from docs/ and the reference at build time
# (site/scripts/sync-docs.mjs, playground.mjs)
site/.astro/
site/public/playground/
site/src/content/docs/specification/
site/src/content/docs/guide/
site/src/content/docs/design/
site/src/content/docs/examples/
site/src/content/docs/tooling/
site/src/content/docs/revisions.md
site/src/content/docs/documentation.md
site/src/samples/synced/

# the editor extensions: bundles, packages, downloaded test hosts
extension/vscode/server/
extension/vscode/syntaxes/
extension/vscode/*.vsix
extension/vscode/.vscode-test/
extension/vscode/.vscode-test-web/
extension/zed/extension.wasm
extension/zed/grammars/

# the grammar compiled beside itself by tree-sitter query / parse runs
tree-sitter-decl/*.dylib
tree-sitter-decl/*.so

# local state: editor project settings (the Zed server path is absolute
# on this machine), the agent's session files
.zed/
.claude/
extension/vscode/LICENSE
